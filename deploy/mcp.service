[Unit]
Description=MCP FastAPI Server
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/mcp
EnvironmentFile=/opt/mcp/.env
Environment=PYTHONPATH=/opt/mcp/src
ExecStart=/opt/mcp/.venv/bin/uvicorn mcp.main:app --app-dir src --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
