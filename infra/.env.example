COMPOSE_PROJECT_NAME=mcp

MCP_HOST_PORT=8000
MCP_PROMPTS_DIR=./prompts

MCP_ANALYSIS_VERSION=realtime-v1
MCP_DEFAULT_MAX_RECENT_MESSAGES=8
MCP_DEFAULT_MAX_CANDIDATE_BLOCKS=8
MCP_ROUTING_APPEND_THRESHOLD=0.40
MCP_ROUTING_TAIL_LIMIT=6

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_ROUTE_MODEL=qwen2.5:3b
OLLAMA_ROUTE_TIMEOUT_SECONDS=30
OLLAMA_ROUTE_TEMPERATURE=0
OLLAMA_METADATA_MODEL=gpt-oss:20b
OLLAMA_METADATA_TIMEOUT_SECONDS=60
OLLAMA_METADATA_TEMPERATURE=0

# Deprecated compatibility keys for the current single-model code path.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=30

DEVLOG_BASE_URL=http://devlog-backend:8081
DEVLOG_INTERNAL_API_KEY=change-me
DEVLOG_TIMEOUT_SECONDS=10

MCP_CORS_ALLOW_ORIGINS=
MCP_ROUTE_PROMPT_FILE=/prompts/route_router.txt
MCP_ROUTE_PROMPT_TEMPLATE=
MCP_METADATA_PROMPT_FILE=/prompts/metadata_builder.txt
MCP_METADATA_PROMPT_TEMPLATE=
MCP_APPEND_PROMPT_FILE=
MCP_APPEND_PROMPT_TEMPLATE=
# Deprecated compatibility key for the current route prompt path.
MCP_NARRATIVE_PROMPT_FILE=/prompts/route_router.txt
MCP_NARRATIVE_PROMPT_TEMPLATE=

# Test driver
DEVLOG_DB_CONTAINER=devlog-db
DEVLOG_DB_NAME=devlog
DEVLOG_DB_USER=devlog_app
DEVLOG_DB_PASSWORD=change-me
LOCAL_LLM_TEST_SESSION_TITLE=Realtime dummy session 100
